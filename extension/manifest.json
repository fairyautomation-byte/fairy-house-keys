{
  "update_url": "https://clients2.google.com/service/update2/crx",
  "manifest_version": 3,
  "name": "Fairy House AutoData",
  "version": "2.1.0",
  "description": "Giáº£i phÃ¡p AI Automation Ä‘á»‰nh cao - Fairy House Team",
  "permissions": [
    "scripting",
    "storage",
    "tabs",
    "cookies"
  ],
  "host_permissions": [
    "*://facebook.com/*",
    "*://*.facebook.com/*",
    "*://adsmanager.facebook.com/*",
    "*://business.facebook.com/*",
    "https://graph.facebook.com/*",
    "https://fairyautomation.io.vn/*",
    "https://*.fairyautomation.io.vn/*",
    "https://fairy-house-keys.vercel.app/*"
  ],
  "background": {
    "service_worker": "src/background/index.js"
  },
  "action": {
    "default_title": "Fairy House AutoData V2.0",
    "default_popup": "src/ui/action-popup.html",
    "default_icon": {
      "16": "icons/logo.png",
      "32": "icons/logo.png",
      "48": "icons/logo.png",
      "128": "icons/logo.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://facebook.com/*",
        "*://*.facebook.com/groups/*",
        "*://*.facebook.com/profile.php*",
        "*://*.facebook.com/*"
      ],
      "js": [
        "src/core/zt-server-session.js",
        "src/core/phone-display.js",
        "src/core/auth.js",
        "src/core/api.js",
        "src/core/profile-resolve.js",
        "src/core/fanpage-resolve.js",
        "src/content/profile-location.js",
        "src/content/inject-button.js",
        "src/content/index.js",
        "src/content/business-inbox-phone.js",
        "src/content/messenger-personal-phone.js",
        "src/content/profile-cover-phone.js",
        "src/core/zt-server-fb-sync.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/ui/modal.html",
        "src/ui/modal-loader.js",
        "src/ui/modal.js",
        "src/ui/zt-xlsx.js",
        "src/ui/styles.css",
        "src/ui/business-inbox-phone.css",
        "src/ui/tailwind.min.js",
        "src/core/phone-display.js",
        "icons/logo.png",
        "src/content/lsd-capture.js"
      ],
      "matches": [
        "*://facebook.com/*",
        "*://*.facebook.com/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/logo.png",
    "32": "icons/logo.png",
    "48": "icons/logo.png",
    "128": "icons/logo.png"
  }
}
